# ==================================================
# DATABASE CONFIGURATION
# ==================================================
# PostgreSQL connection string (Neon / Supabase / Local PostgreSQL)
# Example: postgresql://postgres:password@localhost:5432/streamflix?schema=public
# Or for local SQLite development: file:./dev.db
DATABASE_URL="file:./dev.db"

# ==================================================
# AUTHENTICATION (Auth.js / NextAuth)
# ==================================================
NEXTAUTH_SECRET="streamflix-super-secret-jwt-signing-key-32-chars-min"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="streamflix-super-secret-jwt-signing-key-32-chars-min"

# Optional Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ==================================================
# TMDB API (The Movie Database)
# ==================================================
# Get a free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=""
TMDB_BASE_URL="https://api.themoviedb.org/3"

# ==================================================
# STRIPE PAYMENTS & SUBSCRIPTIONS
# ==================================================
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_BASIC="price_basic_mock"
STRIPE_PRICE_STANDARD="price_standard_mock"
STRIPE_PRICE_PREMIUM="price_premium_mock"

# ==================================================
# APPLICATION URL
# ==================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==================================================
# VIDEO STREAMING PROVIDER
# ==================================================
# Options: demo | mux | cloudinary
VIDEO_PROVIDER="demo"
DEFAULT_VIDEO_URL="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4"

# ==================================================
# CLOUDINARY (OPTIONAL MEDIA CDN)
# ==================================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
